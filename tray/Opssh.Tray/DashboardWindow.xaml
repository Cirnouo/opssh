<Window
    x:Class="Opssh.Tray.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="DashboardRoot" Background="{ThemeResource DashboardFrameBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="DashboardTitleBar" Height="38">
            <StackPanel Margin="14,0" Spacing="8" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="4" Style="{StaticResource DashboardLogoStyle}">
                    <ContentControl Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                        ContentTemplate="{StaticResource DashboardTerminalIcon}" />
                </Border>
                <TextBlock Text="opssh" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="186"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="620"
            CompactModeThresholdWidth="0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            IsTitleBarAutoPaddingEnabled="False">
            <Border
                x:Name="PageSurface"
                Background="{ThemeResource DashboardLayerBrush}"
                BorderBrush="{ThemeResource DashboardLineBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid>
                    <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <InfoBar x:Name="Feedback" Margin="14,9,14,0" MaxWidth="480" HorizontalAlignment="Center"
                             VerticalAlignment="Top" IsClosable="True" />
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
