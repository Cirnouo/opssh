<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>opssh-core</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Opssh.Tray/ActivityWheel.cs" Link="ActivityWheel.cs" />
    <Compile Include="../Opssh.Tray/DiagnosticEvent.cs" Link="DiagnosticEvent.cs" />
    <Compile Include="../Opssh.Tray/DiagnosticLogStore.cs" Link="DiagnosticLogStore.cs" />
    <Compile Include="../Opssh.Tray/Protocol.cs" Link="Protocol.cs" />
    <Compile Include="../Opssh.Tray/CoreProcess.cs" Link="CoreProcess.cs" />
    <Compile Include="../Opssh.Tray/CoreSession.cs" Link="CoreSession.cs" />
    <Compile Include="../Opssh.Tray/ReleaseCheck.cs" Link="ReleaseCheck.cs" />
    <Compile Include="../Opssh.Tray/Strings.cs" Link="Strings.cs" />
    <Compile Include="../Opssh.Tray/UiPreferences.cs" Link="UiPreferences.cs" />
    <Compile Include="../Opssh.Tray/DefaultAgent.cs" Link="DefaultAgent.cs" />
    <Compile Include="../Opssh.Tray/OpenSshService.cs" Link="OpenSshService.cs" />
    <Compile Include="../Opssh.Tray/LoginStartup.cs" Link="LoginStartup.cs" />
    <Compile Include="../Opssh.Tray/OnePasswordAccounts.cs" Link="OnePasswordAccounts.cs" />
    <Compile Include="../Opssh.Tray/OnePasswordReadiness.cs" Link="OnePasswordReadiness.cs" />
    <Compile Include="../Opssh.Tray/OnePasswordSignature.cs" Link="OnePasswordSignature.cs" />
    <Compile Include="../Opssh.Tray/StartupNotificationAction.cs" Link="StartupNotificationAction.cs" />
    <EmbeddedResource Include="../Opssh.Tray/Localization/*.json" WithCulture="false" LogicalName="Opssh.Tray.Localization.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
