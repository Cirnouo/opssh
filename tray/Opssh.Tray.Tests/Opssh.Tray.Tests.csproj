<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>opssh-core</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Opssh.Tray/Protocol.cs" Link="Protocol.cs" />
    <Compile Include="../Opssh.Tray/CoreProcess.cs" Link="CoreProcess.cs" />
    <Compile Include="../Opssh.Tray/CoreSession.cs" Link="CoreSession.cs" />
  </ItemGroup>
</Project>
